<?xml version="1.0" encoding="UTF-8"?>
<!-- Owner: Nguoi1 -->
<!--
  Parent POM của toàn bộ project (Maven multi-module).

  Thư viện dùng trong project (đã thống nhất, muốn thêm thư viện khác phải hỏi nhóm trước):
    - Gson         : đọc/ghi JSON cho protocol
    - sqlite-jdbc  : SQLite qua JDBC
    - OSHI         : đọc CPU/RAM/process/USB/network phía client
    - JUnit 5      : test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>exam</groupId>
  <artifactId>ltm-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>LTM - He thong thi trac nghiem co giam sat</name>

  <modules>
    <module>common</module>
    <module>server</module>
    <module>client</module>
    <module>tools</module>
    <module>e2e</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <gson.version>2.11.0</gson.version>
    <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
    <oshi.version>6.6.5</oshi.version>
    <junit.version>5.10.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.oshi</groupId>
        <artifactId>oshi-core</artifactId>
        <version>${oshi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Module nội bộ -->
      <dependency>
        <groupId>exam</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>exam</groupId>
        <artifactId>client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>exam</groupId>
        <artifactId>server</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Tên jar ngắn gọn: server.jar, client.jar, tools.jar, common.jar -->
    <finalName>${project.artifactId}</finalName>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- Log tiếng Việt của test hiện đúng dấu -->
            <argLine>-Dstdout.encoding=UTF-8 -Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.7.1</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Sau khi package, copy mọi thư viện runtime vào target/lib.
        Nhờ vậy chạy bằng:  java -cp "server/target/server.jar:server/target/lib/*" exam.server.ServerMain
        (không cần plugin exec hay fat-jar, dễ hiểu hơn).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
